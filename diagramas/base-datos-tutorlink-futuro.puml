teachers ||--o{ class_teachers
classes ||--o{ enrollments
students ||--o{ enrollments
classes ||--o{ materials
teachers ||--o{ materials
materials ||--o{ material_resources
classes ||--o{ assignments
teachers ||--o{ assignments
