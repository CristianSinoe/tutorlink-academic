# Copia a backend/.env.local y completa únicamente los valores privados.
# Este archivo es para PostgreSQL local + Gmail SMTP. Nunca lo uses en Render.
SPRING_PROFILES_ACTIVE=local

DB_HOST=localhost
DB_PORT=55432
DB_NAME=tutorlink_local
DB_USER=tutorlink_local
DB_PASSWORD=cambia_esta_clave_local
DB_SSL_MODE=disable

SECURITY_JWT_SECRET=crea_un_secreto_local_de_32_caracteres_o_mas
SECURITY_JWT_EXP_MINUTES=120

# Para pruebas locales se mantiene la clave oficial de prueba de reCAPTCHA.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Gmail requiere una contraseña de aplicación de 16 caracteres; no uses la
# contraseña normal de la cuenta. Usa una cuenta exclusiva de desarrollo.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta-dev@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_FROM='TutorLink <tu-cuenta-dev@gmail.com>'
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

APP_OTP_EXP_MINUTES=5
APP_OTP_MAX_ATTEMPTS=5
APP_OTP_RESEND_COOLDOWN_SECONDS=60

APP_SEED_ADMIN_ENABLED=false
APP_SEED_ADMIN_EMAIL=admin.local@example.invalid
APP_SEED_ADMIN_NAME='Administrador Local TutorLink'
# Actívalo solo si quieres una cuenta local propia. En ese caso se le asigna
# una membresía ADMIN en la institución demo indicada abajo.
APP_SEED_ADMIN_PASSWORD=cambia_esta_contrasena_local
APP_SEED_ADMIN_INSTITUTION_CODE=DEMO15-I1
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_TOKEN=

DEMO_TUTORS=20
DEMO_STUDENTS=300
DEMO_PASSWORD=TutorLinkDemo2026!
FRONTEND_BASE_URL=http://localhost:5173
TUTORLINK_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
PORT=8080
LOG_LEVEL=INFO
