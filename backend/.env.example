SPRING_PROFILES_ACTIVE=demo

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tutorlink_demo
DB_USER=change_me
DB_PASSWORD=change_me
DB_SSL_MODE=disable

SECURITY_JWT_SECRET=replace_with_a_secure_jwt_secret
SECURITY_JWT_EXP_MINUTES=120

RECAPTCHA_SITE_KEY=replace_with_recaptcha_site_key
RECAPTCHA_SECRET_KEY=replace_with_recaptcha_secret_key

APP_SEED_ADMIN_ENABLED=false
APP_SEED_ADMIN_EMAIL=admin.demo@example.com
APP_SEED_ADMIN_NAME='Administrador TutorLink Demo'
APP_SEED_ADMIN_PASSWORD=change_me

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_TOKEN=change_me_long_secure_token

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change_me@gmail.com
MAIL_PASSWORD=replace_with_smtp_password
MAIL_FROM=change_me@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

FRONTEND_BASE_URL=http://localhost:5173
TUTORLINK_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*
PORT=8080
LOG_LEVEL=INFO

APP_OTP_EXP_MINUTES=5
APP_OTP_MAX_ATTEMPTS=5
APP_OTP_RESEND_COOLDOWN_SECONDS=60

# Perfil demo: PostgreSQL propio con Flyway y datos sintéticos idempotentes.
# demo-snapshot conserva la copia H2 heredada; no usar con datos reales.
# Para pruebas automatizadas aisladas usar scripts/e2e/prepare-local.py.
DEMO_TUTORS=20
DEMO_STUDENTS=300
DEMO_PASSWORD=change_me_demo_password
