# Solo backend. Copiar valores a Render Environment (sin comillas de shell).
# Si usas este archivo con --env-file, no lo cargues mediante source.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_ROOT_CERT=/etc/secrets/aiven-ca.pem
DB_POOL_MAX=5
SECURITY_JWT_SECRET=
SECURITY_JWT_EXP_MINUTES=120
APP_OTP_EXP_MINUTES=5
APP_OTP_MAX_ATTEMPTS=5
APP_OTP_RESEND_COOLDOWN_SECONDS=60
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=TutorLink <noreply@tutorlink.lat>
FRONTEND_BASE_URL=https://tutorlink-frontend-render-20261024-1.onrender.com
TUTORLINK_CORS_ALLOWED_ORIGIN_PATTERNS=https://tutorlink-frontend-render-20261024-1.onrender.com
APP_SEED_ADMIN_ENABLED=false
ADMIN_BOOTSTRAP_ENABLED=false
